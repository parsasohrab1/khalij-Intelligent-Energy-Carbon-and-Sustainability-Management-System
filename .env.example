# Application
APP_NAME=iEMS
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# Phase 5 — security / CORS (production: AUTH_ENFORCE=true)
AUTH_ENFORCE=false
AUTH_LOGIN_REQUIRE_2FA=false
AUTH_TOKEN_TTL_SECONDS=3600
CORS_ORIGINS=*

# E11 — IdP (OIDC) + multi-site
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_ROLE_CLAIM=roles
OIDC_ADMIN_ROLES=iems-admin,admin
OIDC_OPERATOR_ROLES=iems-operator,operator
OIDC_VIEWER_ROLES=iems-viewer,viewer
OIDC_DEV_BYPASS=false
SITE_CODE=khalij
SITE_NAME=Khalij Complex

# Demo / Kafka-less live UI
# In development (APP_DEBUG / APP_ENV=development) the inline feeder starts automatically.
DEMO_FEEDER=true
DEMO_MEMORY_ONLY=false
DEMO_PREFER_MEMORY=true
PRODUCER_PLANT_CODES=olefin,pta

# E6 — Plant Connect (disables demo memory fallback)
PLANT_CONNECT=false
INGESTION_SOURCE=simulator
OPC_UA_ENDPOINT=
OPC_UA_USERNAME=
OPC_UA_PASSWORD=
OPC_UA_USE_SUBSCRIPTION=true
OPC_UA_ALLOW_UNCERTAIN=true
OPC_UA_TAG_MAP_PATH=infra/opcua/tags.yaml
# E9 — Advisory → Action (setpoint apply; dry-run until OPC_WRITE_ENABLED)
OPC_WRITE_ENABLED=false
OPC_WRITE_DRY_RUN_DEFAULT=true
OPT_REQUIRE_SIM_BEFORE_APPLY=true
OPT_IMPACT_WINDOW_MINUTES=15
OPT_WRITABLE_FIELDS=reactor_temp_c,feed_flow_tonh

# TimescaleDB / PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=iems
POSTGRES_PASSWORD=iems_secret
POSTGRES_DB=iems

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SENSOR_TOPIC=sensor.readings
KAFKA_CONSUMER_GROUP=iems-ingestion

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=energy-prediction

# Ingestion (Phase 1 / E6)
INGESTION_RATE_HZ=1.0
UNIT_CODES=olefin,pta
PRODUCER_PLANT_CODES=olefin,pta
STALE_DATA_SECONDS=5
STREAM_ALERT_COOLDOWN_SECONDS=30

# Carbon & sustainability (Phase 2)
CARBON_FACTORS_PATH=infra/carbon/emission_factors.yaml
CARBON_SCOPE3_PATH=infra/carbon/scope3_factors.yaml
CARBON_REPORTS_EXPORT_DIR=data/reports/carbon
CARBON_ESG_PACK_DIR=data/reports/esg_packs
CARBON_MARKET_STAGING_DIR=data/reports/carbon_market
CARBON_MARKET_REGISTRY_NAME=khalij-carbon-registry
CARBON_MARKET_API_URL=
CARBON_MARKET_API_TOKEN=
CARBON_MARKET_REQUIRE_LOCKED=true
CARBON_REPORT_INTERVAL_SECONDS=300
CARBON_REPORT_COMPLETED_ONLY=false

# ML prediction (Phase 3)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=energy-prediction
MLFLOW_ENABLED=false
ML_MODEL_DIR=data/models
ML_SYNTHETIC_SAMPLES=1500
ML_VSG_SAMPLES=300
ML_VSG_METHOD=mc
ML_MAPE_TARGET=5.0
ML_MAX_LATENCY_MS=3000
ML_RETRAIN_INTERVAL_SECONDS=3600
# E8 — Trusted Models (also implied by PLANT_CONNECT=true)
ML_TRUSTED_MODE=false
ML_ALLOW_SYNTHETIC=true
ML_ALLOW_PHYSICS_FALLBACK=true
ML_ALLOW_VSG_IN_TRUSTED=false
ML_HOLDOUT_RATIO=0.2
ML_DRIFT_PSI_THRESHOLD=0.2
ML_PHYSICS_SCALE_PATH=infra/ml/physics_calibration.yaml
ML_PREFER_TORCH_LSTM=false
ML_MIN_REAL_SAMPLES=50

# Carbon emission factors fallback (used if YAML missing a plant)
EF_NATURAL_GAS_KGCO2_PER_M3=2.0
EF_STEAM_KGCO2_PER_TON=0.3
EF_ELECTRICITY_KGCO2_PER_KWH=0.5

# Phase 5 — monitoring / prod overlay
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
BACKUP_KEEP=14
